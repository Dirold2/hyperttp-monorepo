{
  "name": "hyperttp-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "workspace:add": "node scripts/workspace.ts add",
    "workspace:scan": "node scripts/workspace.ts scan",
    "workspace:status": "node scripts/workspace.ts status",
    "workspace:test": "node --test scripts/workspace.test.ts",
    "tui": "node scripts/tui.ts",
    "update": "node scripts/update.ts",
    "build": "node scripts/workspaces.ts build",
    "typecheck": "node scripts/workspaces.ts typecheck",
    "lint": "node scripts/workspaces.ts lint",
    "format:check": "node scripts/workspaces.ts format:check",
    "test": "node scripts/workspaces.ts test",
    "check": "bun run build && bun run format:check && bun run lint && bun run typecheck && bun run test",
    "check:all": "node scripts/workspaces.ts build --all && node scripts/workspaces.ts typecheck --all && node scripts/workspaces.ts test --all",
    "smoke:node": "bun run --cwd packages/hyperttp smoke:node",
    "smoke:bun": "bun run --cwd packages/hyperttp smoke:bun",
    "smoke:deno": "bun run --cwd packages/hyperttp smoke:deno",
    "smoke:browser": "bun run --cwd packages/hyperttp smoke:browser",
    "pack": "node scripts/pack.ts",
    "release": "node scripts/release-command.ts",
    "release:test": "node --test scripts/release-version.test.ts scripts/release-compare.test.ts scripts/npm-stage.test.ts scripts/npm-registry.test.ts",
    "dist": "node scripts/dist.ts",
    "pub": "node scripts/pub.ts",
    "subtree:push": "node scripts/subtree.ts",
    "subtree:check": "node scripts/subtree.ts --dry-run"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "esbuild": "^0.28.2",
    "oxlint": "^1.90.0",
    "oxfmt": "^0.75.0",
    "@types/node": "^26.6.6"
  }
}
