{
  "name": "@hyperttp/transport-undici",
  "version": "0.4.0",
  "description": "High-performance, extensible HTTP client for undici",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "http",
    "client",
    "high-performance",
    "undici",
    "fetch"
  ],
  "author": "dirold2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT-IF-OR/hyperttp-transport-undici.git"
  },
  "peerDependencies": {
    "@hyperttp/types": "workspace:^",
    "hcacher": "^0.3.0",
    "undici": "^8.12.3"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "build": "node ../../scripts/build-package.ts",
    "clean": "node --input-type=module -e 'import { rmSync } from \"node:fs\"; rmSync(\"dist\", { recursive: true, force: true });'"
  }
}
