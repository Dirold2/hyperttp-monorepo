{
  "name": "@hyperttp/protocol-webrtc",
  "version": "0.1.1",
  "description": "WebRTC peer sessions and media-stream management for Hyperttp.",
  "license": "MIT",
  "author": "dirold2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT-IF-OR/hyperttp-protocol-webrtc.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "build": "node ../../scripts/build-package.mjs",
    "clean": "node --input-type=module -e 'import { rmSync } from \"node:fs\"; rmSync(\"dist\", { recursive: true, force: true });'"
  },
  "dependencies": {
    "werift": "^0.25.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "esbuild": "latest",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@hyperttp/types": "workspace:^"
  },
  "engines": {
    "node": ">=20"
  }
}
