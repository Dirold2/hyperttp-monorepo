{
  "name": "hyperttp",
  "version": "0.7.1",
  "description": "A high-performance, universal HTTP client for Node.js, Bun, Deno and Browser with caching, retries, queueing, rate limiting, cookies and logging.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "http",
    "client",
    "fetch",
    "undici",
    "cache",
    "rate-limit",
    "queue",
    "retry",
    "cookies",
    "logger",
    "bun",
    "deno",
    "isomorphic",
    "hyperttp"
  ],
  "author": "dirold2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dirold2/hyperttp.git"
  },
  "dependencies": {
    "@hyperttp/auth": "workspace:^",
    "@hyperttp/cache": "workspace:^",
    "@hyperttp/core": "workspace:^",
    "@hyperttp/crypto": "workspace:^",
    "@hyperttp/inflight": "workspace:^",
    "@hyperttp/interceptors": "workspace:^",
    "@hyperttp/metrics": "workspace:^",
    "@hyperttp/parser": "workspace:^",
    "@hyperttp/queue": "workspace:^",
    "@hyperttp/ratelimit": "workspace:^",
    "@hyperttp/retry": "workspace:^",
    "@hyperttp/serializer": "workspace:^",
    "@hyperttp/types": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "chalk": "^6.0.1",
    "dotenv-cli": "^11.1.0",
    "esbuild": "^0.28.2",
    "jiti": "^2.7.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint src tests vitest.config.ts",
    "lint:fix": "oxlint src tests vitest.config.ts --fix",
    "format": "oxfmt src tests vitest.config.ts",
    "format:check": "oxfmt src tests vitest.config.ts --check",
    "test": "vitest run",
    "smoke:node": "node scripts/smoke-runtime.mjs",
    "smoke:bun": "bun scripts/smoke-runtime.mjs",
    "smoke:deno": "deno run --no-config --no-lock --node-modules-dir=manual --allow-read --allow-env scripts/smoke-runtime.mjs",
    "smoke:browser": "node scripts/smoke-chromium.mjs",
    "dev": "tsx src/index.ts",
    "build": "node ../../scripts/build-package.ts",
    "clean": "node --input-type=module -e 'import { rmSync } from \"node:fs\"; rmSync(\"dist\", { recursive: true, force: true });'"
  }
}
