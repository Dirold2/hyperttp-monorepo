{
  "name": "@hyperttp/protocol-grpc",
  "version": "0.1.0",
  "description": "grpc",
  "keywords": [
    "grpc"
  ],
  "license": "MIT",
  "author": "dirold2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT-IF-OR/hyperttp-protocol-grpc.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint src tests --fix",
    "format": "oxfmt src tests",
    "format:check": "oxfmt src tests --check",
    "build": "node ../../scripts/build-package.mjs",
    "clean": "node --input-type=module -e 'import { rmSync } from \"node:fs\"; rmSync(\"dist\", { recursive: true, force: true });'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "latest",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@hyperttp/types": "workspace:^",
    "typescript": "^7.0.2"
  }
}
